HOLABOSS_AUTH_BASE_URL=https://api.holaboss.ai
HOLABOSS_AUTH_SIGN_IN_URL=https://www.holaboss.ai/signin
HOLABOSS_BACKEND_BASE_URL=https://api.holaboss.ai
HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=https://api.holaboss.ai/gateway/sandbox

# Web frontend origin that hosts web HolaApp pages
HOLABOSS_WEB_APP_BASE_URL=https://www.holaos.ai

# Sentry error tracking (optional)
# SENTRY_DSN=

# ============================================================================
# BISTURÍ INTEGRATION - Capa 1 Governance for holaOS (Capa 2)
# ============================================================================

# Bisturí Core Repository (Private)
BISTURI_REPO_URL=https://github.com/Helldustxiii/NYX-BISTURI
BISTURI_REPO_PAT=your_github_pat_here

# Bisturí Sistema Prompts Location
BISTURI_SYSTEM_PROMPT_PATH=BISTURI/sistema-prompts

# Bisturí Jardín (Memory & Learning)
BISTURI_JARDIN_PATH=BISTURI/JARDIN

# ============================================================================
# BISTURÍ FUNCTION ACCESS (7 Core Functions)
# ============================================================================

# 1. COMPRENDER - Read and analyze context
BISTURI_FUNC_COMPRENDER=enabled

# 2. DECIDIR - Evaluate options and choose path
BISTURI_FUNC_DECIDIR=enabled

# 3. EJECUTAR - Delegate tasks to holaOS
BISTURI_FUNC_EJECUTAR=enabled

# 4. REGISTRAR - Save to Jardín (Garden)
BISTURI_FUNC_REGISTRAR=enabled

# 5. JARDIN_READ - Read previous decisions and learnings
BISTURI_FUNC_JARDIN_READ=enabled

# 6. JARDIN_WRITE - Write new entries to Jardín
BISTURI_FUNC_JARDIN_WRITE=enabled

# 7. VALIDATE_PRINCIPLES - Check against Bisturí principles
BISTURI_FUNC_VALIDATE_PRINCIPLES=enabled

# ============================================================================
# BISTURÍ OPERATION SETTINGS
# ============================================================================

# System Prompt Mode: Use Bisturí as primary governance
HOLAOS_SYSTEM_PROMPT_SOURCE=bisturi

# Bisturí Principles Enforcement (strict|moderate|advisory)
BISTURI_PRINCIPLES_MODE=strict

# Require Bisturí validation before holaOS execution
BISTURI_VALIDATION_REQUIRED=true

# Enable Bisturí decision logging
BISTURI_LOG_DECISIONS=true

# Auto-save to Jardín after each execution
BISTURI_AUTO_REGISTER=true

# Maximum hops (decision chains) before requiring user confirmation
BISTURI_MAX_DECISION_CHAIN=3
